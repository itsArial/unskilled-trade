ADMIN_EMAIL=admin@unskilled.local
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
DATABASE_PATH=unskilled.db
BIND_ADDRESS=127.0.0.1:8080
COOKIE_SECURE=false
FRONTEND_DIST=../frontend/dist
# Free shared endpoint for optional manual history collection, not production streaming.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Candidate-wallet discovery. Off unless explicitly enabled. Observation only:
# discovered wallets are not eligible for paper execution until history is
# collected and the normal analytics gates pass.
DISCOVERY_ENABLED=false
PUMPPORTAL_WS_URL=wss://pumpportal.fun/api/data
# Token creations are free; trade subscriptions are not. Without a key funded
# with >= 0.02 SOL the provider refuses them and the collector records no
# trades, ticks or candidates. The refusal is surfaced, not swallowed.
PUMPPORTAL_API_KEY=
DISCOVERY_MIN_SOL=2.0
DISCOVERY_TRACKED_TOKENS=150

# Token safety gate. A missing report is "unknown", never "safe".
# Set TOKEN_RISK_REQUIRED=true for real data: unknown tokens then cannot be entered.
RUGCHECK_BASE_URL=https://api.rugcheck.xyz/v1
TOKEN_RISK_REQUIRED=false
TOKEN_RISK_MAX_SCORE=40
TOKEN_RISK_MIN_LP_LOCKED=50
TOKEN_RISK_MAX_AGE=86400

# Follower simulation. Cost is charged on both sides; the wait is how long an
# order may sit before it counts as unfilled rather than filled at a stale price.
COPY_COST_BPS=200
COPY_MAX_WAIT_SECONDS=3600

# Tick-evaluated exits. These fire on observed price alone, with no leader event.
EXIT_HARD_STOP_PCT=20
EXIT_TRAILING_PCT=25
EXIT_TIME_STOP_SECONDS=86400

# Authenticity checks. A wallet that is always first into a token is profitable
# for a reason a follower cannot reproduce. Set ENFORCE_AUTHENTICITY=false to
# report the measure without gating on it.
EARLY_ENTRY_WINDOW_SECONDS=30
MAX_EARLY_ENTRY_PCT=80
ENFORCE_AUTHENTICITY=true

# --- Custody -----------------------------------------------------------------
# Holding user private keys makes this service a custodian (CASP under MiCA in
# the EU, money transmission in most US states). Leave unset to disable custody
# entirely; a missing key never causes plaintext key storage.
# Generate: 32 random bytes, base58-encoded.
CUSTODY_MASTER_KEY=
WITHDRAWALS_ENABLED=false

# --- Access and commission ---------------------------------------------------
# subscription = sell access. commission = access is free, we take a cut.
ACCESS_MODEL=subscription
# performance (default) | per_trade | hybrid | none. See docs/METHODOLOGY.md for
# why per_trade is not the default.
FEE_MODEL=performance
FEE_PERFORMANCE_BPS=1500
FEE_TRADE_BPS=0
FEE_TRADE_FIXED_LAMPORTS=0
FEE_EPOCH_SECONDS=604800
FEE_MIN_SETTLEMENT_LAMPORTS=1000000

# Network cost per trade side: fixed lamports plus basis points. The fixed term
# dominates at small order sizes, which is the direction the liquidity cap pushes.
COPY_COST_FIXED_LAMPORTS=150000
COPY_FAILURE_RATE=0

# --- Running on real market data ---------------------------------------------
# Write observed live trades into analyzable history and evaluate followers
# against them. Still paper: nothing is signed. Requires DISCOVERY_ENABLED=true.
DISCOVERY_INGEST_TRADES=false
# A Pump.fun curve migrates near 85 SOL of real reserve, so the 100 SOL default
# is unreachable pre-graduation. Lower it deliberately to trade the curve.
MIN_LIQUIDITY_SOL=100
# Close a curve position this far toward migration, where pool depth drops.
EXIT_GRADUATION_PROGRESS=0.9

# --- Live copy feed ----------------------------------------------------------
# One logsSubscribe per followed wallet. Volume scales with the follow list, not
# the market, which is what keeps it inside a provider's free tier. Leave
# SOLANA_WS_URL unset to derive it from SOLANA_RPC_URL.
WATCH_ENABLED=false
SOLANA_WS_URL=
WATCH_MAX_WALLETS=50

# Ids are composite keys (source:signature:wallet, ~137 chars for real data).

# --- Token socials -----------------------------------------------------------
# Handle reuse across mints is derived from our own observations and costs
# nothing. Resolving a handle to its immutable account id — which is what makes
# *rename* detection possible — needs X, which has no free tier since Feb 2026
# and meters reads. Leave empty to run reuse-only.
X_API_BEARER=

# --- Swap execution ----------------------------------------------------------
# Jupiter Swap V2. Works with no API key; a key raises rate limits.
JUPITER_BASE_URL=https://api.jup.ag/swap/v2
JUPITER_API_KEY=
# Integrator fee in basis points, hard-capped at 300 (3%). Charged inside the
# swap, so it settles with the trade or the trade does not happen.
PLATFORM_FEE_BPS=50
# Token account that receives the fee; its mint must be one of the pair being
# swapped. A WSOL account covers every SOL-paired trade. Without this NO fee is
# requested at all — the service never claims a fee it cannot receive.
PLATFORM_FEE_ACCOUNT=
# Refuse to build a transaction above this slippage.
MAX_SLIPPAGE_BPS=1000

# --- Market data -------------------------------------------------------------
# DexScreener: no key, ~300 req/min for pairs and 60/min for profiles, and it
# publishes no rate-limit headers, so throttling is expected. Cache accordingly.
MARKET_BASE_URL=https://api.dexscreener.com
MARKET_CACHE_SECONDS=20

# --- Charts ------------------------------------------------------------------
# GeckoTerminal OHLCV: no key, roughly 30 requests a minute.
CHART_BASE_URL=https://api.geckoterminal.com/api/v2
CHART_CACHE_SECONDS=60

# The one funding pattern strong enough to gate on: a provable transfer from a
# token's deployer to a wallet, before that wallet buys that token. Published
# work found 87% of such snipes profitable — position, not skill. Everything
# weaker stays report-only.
ENFORCE_DEPLOYER_FUNDING=false
DEPLOYER_FUNDING_WINDOW=86400
